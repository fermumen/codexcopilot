#!/usr/bin/env sh
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$DIR/bin/githubcopilot" ]; then
  exec "$DIR/bin/githubcopilot" "$@"
fi

if command -v go >/dev/null 2>&1; then
  exec go run "$DIR/cmd/githubcopilot" "$@"
fi

echo "githubcopilot binary not found and Go is not installed." >&2
echo "Build on a machine with Go using: go build -o bin/githubcopilot ./cmd/githubcopilot" >&2
exit 127

